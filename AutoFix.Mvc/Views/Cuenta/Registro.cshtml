@model RegistroVm
@{ ViewData["Title"] = "Crear cuenta"; }
<div class="acceso">
    <section class="lado">
        <div>
            <h1>AutoFix</h1>
            <p class="mt-3">Con tu cuenta consultas tus vehículos, el estado de cada reparación y los presupuestos.</p>
        </div>
        <p class="usuarios-prueba mb-0">Si ya dejaste tu vehículo en el taller, usa el mismo DUI y correo que diste en recepción.</p>
    </section>
    <section class="formulario">
        <div>
            <h2 class="titulo mb-3">Crear cuenta de cliente</h2>
            <form asp-action="Registro" method="post" novalidate>
                <div asp-validation-summary="ModelOnly" class="mb-3"></div>
                <div class="mb-3">
                    <label asp-for="NombreCompleto" class="form-label"></label>
                    <input asp-for="NombreCompleto" class="form-control" />
                    <span asp-validation-for="NombreCompleto"></span>
                </div>
                <div class="row g-3 mb-3">
                    <div class="col-sm-6">
                        <label asp-for="Dui" class="form-label"></label>
                        <input asp-for="Dui" class="form-control" placeholder="01234567-8" />
                        <span asp-validation-for="Dui"></span>
                    </div>
                    <div class="col-sm-6">
                        <label asp-for="Telefono" class="form-label"></label>
                        <input asp-for="Telefono" class="form-control" placeholder="7000-0000" />
                        <span asp-validation-for="Telefono"></span>
                    </div>
                </div>
                <div class="mb-3">
                    <label asp-for="Direccion" class="form-label"></label>
                    <input asp-for="Direccion" class="form-control" />
                    <span asp-validation-for="Direccion"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Email" class="form-label"></label>
                    <input asp-for="Email" class="form-control" autocomplete="username" />
                    <span asp-validation-for="Email"></span>
                </div>
                <div class="row g-3 mb-4">
                    <div class="col-sm-6">
                        <label asp-for="Password" class="form-label"></label>
                        <input asp-for="Password" class="form-control" autocomplete="new-password" />
                        <span asp-validation-for="Password"></span>
                    </div>
                    <div class="col-sm-6">
                        <label asp-for="ConfirmarPassword" class="form-label"></label>
                        <input asp-for="ConfirmarPassword" class="form-control" autocomplete="new-password" />
                        <span asp-validation-for="ConfirmarPassword"></span>
                    </div>
                </div>
                <button type="submit" class="btn btn-primario w-100 py-2">Crear cuenta</button>
            </form>
            <p class="mt-4 mb-0"><a asp-action="Login">Ya tengo cuenta</a></p>
        </div>
    </section>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
