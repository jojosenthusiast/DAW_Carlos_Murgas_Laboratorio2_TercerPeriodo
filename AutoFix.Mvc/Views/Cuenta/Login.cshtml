@model LoginVm
@inject IWebHostEnvironment Env
@{
    ViewData["Title"] = "Iniciar sesión";
    var demo = Env.IsDevelopment();
}
<div class="acceso">
    <section class="lado">
        <div>
            <h1 class="logo-grande"><i class="bi bi-wrench-adjustable-circle-fill"></i>AutoFix</h1>
            <p class="mt-3">Recepción, diagnóstico, presupuestos e inventario del taller en un solo lugar. Los clientes siguen aquí el avance de su vehículo.</p>
        </div>
        <ul class="puntos-fuertes">
            <li><i class="bi bi-clipboard-check"></i>Órdenes de reparación con seguimiento por estado</li>
            <li><i class="bi bi-receipt"></i>Presupuestos claros, aprobación en línea</li>
            <li><i class="bi bi-camera"></i>Fotografías del antes y el después</li>
        </ul>
    </section>
    <section class="formulario">
        <div>
            <h2 class="titulo mb-1">Iniciar sesión</h2>
            <p class="texto-suave mb-4">Usa el correo con el que te registraron en el taller.</p>
            @if (ViewBag.Aviso is string aviso)
            {
                <div class="alert aviso-alerta">@aviso</div>
            }
            <form asp-action="Login" asp-route-returnUrl="@ViewData["ReturnUrl"]" method="post" novalidate>
                <div asp-validation-summary="ModelOnly" class="mb-3"></div>
                <div class="mb-3">
                    <label asp-for="Email" class="form-label"></label>
                    @if (demo)
                    {
                        <div class="combo" id="combo">
                            <input asp-for="Email" class="form-control" autocomplete="username" autofocus role="combobox" aria-expanded="false" aria-controls="comboLista" aria-autocomplete="list" placeholder="correo@ejemplo.com o elige un usuario" />
                            <partial name="_UsuariosDemo" />
                        </div>
                        <div class="form-text"><i class="bi bi-code-slash me-1"></i>Modo desarrollo: elige un usuario de demostración o escribe otro correo.</div>
                    }
                    else
                    {
                        <input asp-for="Email" class="form-control" autocomplete="username" autofocus />
                    }
                    <span asp-validation-for="Email"></span>
                </div>
                <div class="mb-4">
                    <label asp-for="Password" class="form-label"></label>
                    <input asp-for="Password" class="form-control" autocomplete="current-password" id="Password" />
                    <span asp-validation-for="Password"></span>
                </div>
                <button type="submit" class="btn btn-primario w-100 py-2">Entrar<i class="bi bi-arrow-right ms-2"></i></button>
            </form>
            <p class="mt-4 mb-0">¿Eres cliente y aún no tienes cuenta? <a asp-action="Registro">Crea tu cuenta</a></p>
        </div>
    </section>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    @if (demo)
    {
        <script src="~/js/login-demo.js" asp-append-version="true"></script>
    }
}
