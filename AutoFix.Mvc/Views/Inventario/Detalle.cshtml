@model InventarioDetallePaginaVm
@{
    var r = Model.Repuesto;
    ViewData["Title"] = r.Nombre;
    var gestiona = User.Puede(Permisos.InventarioGestionar);
}
<div class="encabezado">
    <div>
        <h1 class="titulo">@r.Nombre</h1>
        <p class="texto-suave mb-0">@r.Codigo. @r.Categoria, @r.Marca</p>
    </div>
    @if (gestiona)
    {
        <div class="d-flex gap-2">
            <a asp-action="Editar" asp-route-id="@r.Id" class="btn btn-secundario">Editar</a>
            <form asp-action="Estado" asp-route-id="@r.Id" method="post" data-confirmar="@(r.Activo ? "¿Desactivar este repuesto?" : "¿Activar este repuesto?")">
                <input type="hidden" name="activo" value="@((!r.Activo).ToString().ToLowerInvariant())" />
                <button class="btn @(r.Activo ? "btn-peligro" : "btn-primario")">@(r.Activo ? "Desactivar" : "Activar")</button>
            </form>
        </div>
    }
</div>
@if (r.EnAlerta && r.Activo)
{
    <div class="alert aviso-alerta">Este repuesto llegó al stock mínimo (@r.Existencias de mínimo @r.StockMinimo). Registra una entrada.</div>
}
<div class="row g-4">
    <div class="col-lg-4">
        <div class="panel mb-4">
            @if (Rutas.Imagen(r.FotoRuta) is string url)
            {
                <img src="@url" class="miniatura mb-3" alt="Fotografía de @r.Nombre" />
            }
            else
            {
                <div class="sin-foto mb-3"><span><i class="bi bi-box-seam me-2"></i>Sin fotografía</span></div>
            }
            <div class="d-flex justify-content-between"><span class="texto-suave">Existencias</span><strong class="fs-4">@r.Existencias</strong></div>
            <div class="d-flex justify-content-between"><span class="texto-suave">Stock mínimo</span><span>@r.StockMinimo</span></div>
            <div class="d-flex justify-content-between"><span class="texto-suave">Precio</span><span>@Formato.Dinero(r.Precio)</span></div>
            @if (!string.IsNullOrWhiteSpace(r.Descripcion)) { <p class="small mt-3 mb-0">@r.Descripcion</p> }
            @if (gestiona)
            {
                <form asp-action="Foto" asp-route-id="@r.Id" method="post" enctype="multipart/form-data" class="mt-3">
                    <label for="archivo" class="form-label small">Fotografía (JPG o PNG, máx. 5 MB)</label>
                    <input type="file" id="archivo" name="archivo" class="form-control form-control-sm mb-2" accept=".jpg,.jpeg,.png" required />
                    <button class="btn btn-sm btn-primario">Subir fotografía</button>
                </form>
            }
        </div>
        @if (gestiona && r.Activo)
        {
            <div class="panel">
                <h2 class="subtitulo">Registrar movimiento</h2>
                <form asp-action="Movimiento" method="post">
                    <input type="hidden" name="RepuestoId" value="@r.Id" />
                    <input type="hidden" name="Version" value="@r.Version" />
                    <div class="btn-group w-100 mb-2" role="group" aria-label="Tipo de movimiento">
                        <input type="radio" class="btn-check" name="Tipo" id="tipoEntrada" value="Entrada" checked />
                        <label class="btn btn-secundario" for="tipoEntrada">Entrada</label>
                        <input type="radio" class="btn-check" name="Tipo" id="tipoSalida" value="Salida" />
                        <label class="btn btn-secundario" for="tipoSalida">Salida</label>
                    </div>
                    <label for="cantidadMov" class="form-label">Cantidad</label>
                    <input type="number" id="cantidadMov" name="Cantidad" class="form-control mb-2" min="1" max="100000" value="1" required />
                    <label for="motivoMov" class="form-label">Motivo</label>
                    <input id="motivoMov" name="Motivo" class="form-control mb-3" minlength="3" maxlength="250" required placeholder="Compra a proveedor, ajuste, uso en taller..." />
                    <button class="btn btn-primario w-100">Registrar</button>
                    <p class="small texto-suave mt-2 mb-0">Una salida nunca deja existencias negativas. Si otro usuario modifica el repuesto al mismo tiempo, recibirás un aviso de conflicto.</p>
                </form>
            </div>
        }
    </div>
    <div class="col-lg-8">
        <h2 class="subtitulo">Movimientos</h2>
        <div class="tabla">
            <table class="table table-sm">
                <thead><tr><th>Fecha</th><th>Tipo</th><th class="text-end">Cantidad</th><th class="text-end">Antes</th><th class="text-end">Después</th><th>Motivo</th><th>Orden</th><th>Usuario</th></tr></thead>
                <tbody>
                @if (Model.Movimientos.Count == 0)
                {
                    <tr><td colspan="8" class="vacio"><i class="bi bi-inbox"></i><span>Sin movimientos.</span></td></tr>
                }
                @foreach (var m in Model.Movimientos)
                {
                    <tr>
                        <td class="text-nowrap">@Formato.Fecha(m.Fecha)</td>
                        <td><span class="tag @(m.Tipo == "Entrada" ? "tag-verde-claro" : "tag-azul")">@m.Tipo</span></td>
                        <td class="text-end">@m.Cantidad</td>
                        <td class="text-end">@m.ExistenciaAnterior</td>
                        <td class="text-end">@m.ExistenciaNueva</td>
                        <td>@m.Motivo</td>
                        <td>@if (m.OrdenId.HasValue) { <a asp-controller="Ordenes" asp-action="Detalle" asp-route-id="@m.OrdenId">@(m.NumeroOrden ?? "Ver")</a> }</td>
                        <td class="small">@m.Usuario</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
</div>
