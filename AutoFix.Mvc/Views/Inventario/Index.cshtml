@model List<RepuestoVm>
@{
    ViewData["Title"] = "Inventario";
    var gestiona = User.Puede(Permisos.InventarioGestionar);
    var soloAlertas = (ViewBag.SoloAlertas as bool?) == true;
    var enAlerta = Model.Count(r => r.EnAlerta && r.Activo);
}
<div class="encabezado">
    <div>
        <h1 class="titulo">Inventario de repuestos</h1>
        @if (enAlerta > 0)
        {
            <p class="mb-0"><span class="tag tag-ambar">@enAlerta repuesto(s) en stock mínimo</span></p>
        }
    </div>
    @if (gestiona)
    {
        <a asp-action="Crear" class="btn btn-senal"><i class="bi bi-plus-lg me-1"></i>Registrar repuesto</a>
    }
</div>
<form method="get" class="row g-2 mb-3 align-items-center">
    <div class="col-md-5 col-lg-4">
        <input type="search" name="buscar" value="@ViewBag.Buscar" class="form-control" placeholder="Código, nombre o marca" aria-label="Buscar repuesto" />
    </div>
    <div class="col-auto form-check ms-2">
        <input class="form-check-input" type="checkbox" name="soloAlertas" value="true" id="soloAlertas" checked="@soloAlertas" />
        <label class="form-check-label" for="soloAlertas">Solo en stock mínimo</label>
    </div>
    <div class="col-auto"><button class="btn btn-primario">Filtrar</button></div>
</form>
<div class="tabla">
    <table class="table table-hover">
        <thead><tr><th>Código</th><th>Nombre</th><th>Categoría</th><th>Marca</th><th class="text-end">Precio</th><th class="text-end">Existencias</th><th class="text-end">Mínimo</th><th>Estado</th></tr></thead>
        <tbody>
        @if (Model.Count == 0)
        {
            <tr><td colspan="8" class="texto-suave p-4">No hay repuestos con ese criterio.</td></tr>
        }
        @foreach (var r in Model)
        {
            <tr class="@(r.EnAlerta && r.Activo ? "fila-alerta" : "")">
                <td><a asp-action="Detalle" asp-route-id="@r.Id"><strong>@r.Codigo</strong></a></td>
                <td>@r.Nombre</td>
                <td>@r.Categoria</td>
                <td>@r.Marca</td>
                <td class="text-end">@Formato.Dinero(r.Precio)</td>
                <td class="text-end fw-semibold">@r.Existencias</td>
                <td class="text-end">@r.StockMinimo</td>
                <td>
                    @if (!r.Activo) { <span class="tag tag-gris">Inactivo</span> }
                    else if (r.EnAlerta) { <span class="tag tag-ambar">Stock mínimo</span> }
                    else { <span class="tag tag-verde-claro">Disponible</span> }
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>
