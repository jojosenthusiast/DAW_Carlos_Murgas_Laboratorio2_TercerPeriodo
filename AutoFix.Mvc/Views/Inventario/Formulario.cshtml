@model RepuestoFormVm
@{
    var editando = Model.Id.HasValue;
    ViewData["Title"] = editando ? "Editar repuesto" : "Registrar repuesto";
}
<div class="encabezado"><h1 class="titulo">@ViewData["Title"]</h1></div>
<div class="panel" style="max-width: 760px">
    <form asp-action="@(editando ? "Editar" : "Crear")" asp-route-id="@Model.Id" method="post" novalidate>
        <input type="hidden" asp-for="Version" />
        <div asp-validation-summary="ModelOnly" class="mb-3"></div>
        <div class="row g-3 mb-3">
            <div class="col-md-4">
                <label asp-for="Codigo" class="form-label"></label>
                <input asp-for="Codigo" class="form-control text-uppercase" placeholder="FIL-ACE-001" />
                <span asp-validation-for="Codigo"></span>
            </div>
            <div class="col-md-8">
                <label asp-for="Nombre" class="form-label"></label>
                <input asp-for="Nombre" class="form-control" />
                <span asp-validation-for="Nombre"></span>
            </div>
        </div>
        <div class="mb-3">
            <label asp-for="Descripcion" class="form-label"></label>
            <textarea asp-for="Descripcion" rows="2" class="form-control"></textarea>
        </div>
        <div class="row g-3 mb-3">
            <div class="col-md-6">
                <label asp-for="Categoria" class="form-label"></label>
                <input asp-for="Categoria" class="form-control" />
                <span asp-validation-for="Categoria"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="Marca" class="form-label"></label>
                <input asp-for="Marca" class="form-control" />
                <span asp-validation-for="Marca"></span>
            </div>
        </div>
        <div class="row g-3 mb-4">
            <div class="col-md-4">
                <label asp-for="Precio" class="form-label"></label>
                <input asp-for="Precio" type="number" step="0.01" min="0.01" class="form-control" />
                <span asp-validation-for="Precio"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="Existencias" class="form-label"></label>
                <input asp-for="Existencias" type="number" min="0" class="form-control" disabled="@editando" />
                @if (editando) { <div class="form-text">Las existencias cambian solo con entradas y salidas.</div> }
                <span asp-validation-for="Existencias"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="StockMinimo" class="form-label"></label>
                <input asp-for="StockMinimo" type="number" min="0" class="form-control" />
                <span asp-validation-for="StockMinimo"></span>
            </div>
        </div>
        <button type="submit" class="btn btn-primario">@(editando ? "Guardar cambios" : "Registrar repuesto")</button>
        <a asp-action="Index" class="btn btn-secundario ms-2">Cancelar</a>
    </form>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
