@model ClienteDetalleVm
@{
    var c = Model.Cliente;
    ViewData["Title"] = c.NombreCompleto;
    var gestiona = User.IsInRole(Roles.Administrador) || User.IsInRole(Roles.Recepcionista);
}
<div class="encabezado">
    <div>
        <h1 class="titulo">@c.NombreCompleto</h1>
        <p class="texto-suave mb-0">Cliente desde @Formato.Dia(c.FechaRegistro)</p>
    </div>
    <div class="d-flex gap-2 flex-wrap">
        @if (gestiona)
        {
            <a asp-action="Editar" asp-route-id="@c.Id" class="btn btn-secundario">Editar datos</a>
            <a asp-controller="Vehiculos" asp-action="Crear" asp-route-clienteId="@c.Id" class="btn btn-primario"><i class="bi bi-car-front me-1"></i>Agregar vehículo</a>
        }
        @if (User.Puede(Permisos.OrdenesCrear) && Model.Vehiculos.Count > 0)
        {
            <a asp-controller="Ordenes" asp-action="Crear" asp-route-clienteId="@c.Id" class="btn btn-senal">Nueva orden</a>
        }
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-4">
        <div class="panel">
            <h2 class="subtitulo">Datos de contacto</h2>
            <dl class="mb-0">
                <dt>DUI o identificación</dt><dd>@c.Dui</dd>
                <dt>Teléfono</dt><dd>@c.Telefono</dd>
                <dt>Correo</dt><dd>@c.Correo</dd>
                <dt>Dirección</dt><dd class="mb-0">@c.Direccion</dd>
            </dl>
        </div>
        @if (User.IsInRole(Roles.Administrador))
        {
            <form asp-action="Eliminar" asp-route-id="@c.Id" method="post" class="mt-3" data-confirmar="¿Eliminar este cliente y sus vehículos? Solo es posible si no tiene órdenes.">
                <button class="btn btn-peligro w-100">Eliminar cliente</button>
            </form>
        }
    </div>
    <div class="col-lg-8">
        <div class="panel mb-4">
            <h2 class="subtitulo">Vehículos (@Model.Vehiculos.Count)</h2>
            @if (Model.Vehiculos.Count == 0)
            {
                <p class="texto-suave mb-0">Sin vehículos registrados. Agrega el primero para poder abrir una orden.</p>
            }
            <div class="galeria">
                @foreach (var v in Model.Vehiculos)
                {
                    <a class="foto text-reset text-decoration-none" asp-controller="Vehiculos" asp-action="Detalle" asp-route-id="@v.Id">
                        @if (Rutas.Imagen(v.FotoRuta) is string url)
                        {
                            <img src="@url" alt="Fotografía del vehículo @v.Placa" loading="lazy" />
                        }
                        else
                        {
                            <div class="sin-foto" style="height:150px;border-radius:0"><i class="bi bi-car-front fs-1"></i></div>
                        }
                        <div class="pie"><strong>@v.Placa</strong><br />@v.Marca @v.Modelo @v.Anio, @v.Color</div>
                    </a>
                }
            </div>
        </div>
        <div class="panel">
            <h2 class="subtitulo">Historial de órdenes</h2>
            @if (Model.Ordenes.Count == 0)
            {
                <p class="texto-suave mb-0">Este cliente aún no tiene órdenes de reparación.</p>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table mb-0">
                        <thead><tr><th>Orden</th><th>Vehículo</th><th>Servicio</th><th>Estado</th><th>Ingreso</th></tr></thead>
                        <tbody>
                        @foreach (var o in Model.Ordenes)
                        {
                            <tr>
                                <td><a asp-controller="Ordenes" asp-action="Detalle" asp-route-id="@o.Id">@o.NumeroOrden</a></td>
                                <td>@o.VehiculoPlaca</td>
                                <td>@Formato.Servicio(o.TipoServicio)</td>
                                <td><partial name="_Estado" model="o.Estado" /></td>
                                <td>@Formato.Dia(o.FechaIngreso)</td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>
