@model EvidenciaFormVm
@{ ViewData["Title"] = "Subir fotografía"; }
<div class="encabezado"><h1 class="titulo">Subir fotografía</h1></div>
<div class="panel" style="max-width: 700px">
    <form asp-action="Subir" method="post" enctype="multipart/form-data" novalidate>
        <div asp-validation-summary="All" class="mb-3"></div>
        <div class="mb-3">
            <label asp-for="OrdenId" class="form-label"></label>
            <select asp-for="OrdenId" class="form-select">
                <option value="0">Selecciona la orden</option>
                @foreach (var o in Model.Ordenes)
                {
                    <option value="@o.Id" selected="@(o.Id == Model.OrdenId)">@o.NumeroOrden, @o.VehiculoPlaca (@Formato.Estado(o.Estado))</option>
                }
            </select>
            <span asp-validation-for="OrdenId"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Tipo" class="form-label"></label>
            <select asp-for="Tipo" class="form-select">
                @foreach (var t in Formato.TiposEvidencia)
                {
                    <option value="@t.Valor" selected="@(Model.Tipo == t.Valor)">@t.Texto</option>
                }
            </select>
        </div>
        <div class="mb-3">
            <label asp-for="Archivo" class="form-label"></label>
            <input asp-for="Archivo" type="file" class="form-control" accept=".jpg,.jpeg,.png" />
            <span asp-validation-for="Archivo"></span>
        </div>
        <div class="mb-4">
            <label asp-for="Descripcion" class="form-label"></label>
            <input asp-for="Descripcion" class="form-control" placeholder="Ej.: rayón en puerta trasera izquierda" />
        </div>
        <button type="submit" class="btn btn-primario">Subir fotografía</button>
        <a asp-action="Index" class="btn btn-secundario ms-2">Cancelar</a>
    </form>
</div>
