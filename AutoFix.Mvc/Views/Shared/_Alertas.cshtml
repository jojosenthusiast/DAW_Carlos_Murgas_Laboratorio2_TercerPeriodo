@if (TempData["Exito"] is string exito)
{
    <div class="alert aviso-ok alert-dismissible fade show" role="status">
        <i class="bi bi-check-circle me-2"></i>@exito
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
    </div>
}
@if (TempData["Aviso"] is string aviso)
{
    <div class="alert aviso-alerta alert-dismissible fade show" role="status">
        <i class="bi bi-exclamation-triangle me-2"></i>@aviso
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
    </div>
}
@if (TempData["Error"] is string error)
{
    <div class="alert aviso-error alert-dismissible fade show" role="alert">
        <i class="bi bi-x-octagon me-2"></i>@error
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
    </div>
}
