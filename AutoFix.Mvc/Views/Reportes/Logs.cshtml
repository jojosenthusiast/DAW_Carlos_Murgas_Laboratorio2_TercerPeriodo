@model List<LogVm>
@{
    ViewData["Title"] = "Bitácora de solicitudes";
    var soloErrores = (ViewBag.SoloErrores as bool?) == true;
}
<div class="encabezado">
    <div>
        <h1 class="titulo">Bitácora de solicitudes</h1>
        <p class="texto-suave mb-0">Cada petición a la API con usuario, endpoint, código HTTP, duración y Correlation ID.</p>
    </div>
    <a asp-action="Index" class="btn btn-secundario">Volver a reportes</a>
</div>
<form method="get" class="row g-2 mb-3 align-items-end">
    <div class="col-md-4">
        <label for="correlationId" class="form-label small">Correlation ID</label>
        <input id="correlationId" name="correlationId" value="@ViewBag.CorrelationId" class="form-control" />
    </div>
    <div class="col-md-2">
        <label for="codigo" class="form-label small">Código HTTP</label>
        <input id="codigo" name="codigo" type="number" value="@ViewBag.Codigo" class="form-control" placeholder="409" />
    </div>
    <div class="col-md-3">
        <label for="usuario" class="form-label small">Usuario</label>
        <input id="usuario" name="usuario" value="@ViewBag.Usuario" class="form-control" />
    </div>
    <div class="col-auto form-check ms-2 mb-2">
        <input class="form-check-input" type="checkbox" name="soloErrores" value="true" id="soloErrores" checked="@soloErrores" />
        <label class="form-check-label" for="soloErrores">Solo errores (4xx y 5xx)</label>
    </div>
    <div class="col-auto"><button class="btn btn-primario">Filtrar</button></div>
</form>
<div class="tabla">
    <table class="table table-sm">
        <thead><tr><th>Fecha y hora</th><th>Usuario</th><th>Método y endpoint</th><th class="text-center">Código</th><th class="text-end">Duración</th><th>Correlation ID</th><th>Error</th></tr></thead>
        <tbody>
        @if (Model.Count == 0)
        {
            <tr><td colspan="7" class="vacio"><i class="bi bi-inbox"></i><span>No hay registros con ese filtro.</span></td></tr>
        }
        @foreach (var l in Model)
        {
            var clase = l.CodigoEstado >= 500 ? "tag-rojo" : l.CodigoEstado >= 400 ? "tag-ambar" : "tag-verde-claro";
            <tr>
                <td class="text-nowrap">@l.Fecha.ToString("yyyy-MM-dd HH:mm:ss")</td>
                <td class="small">@l.Usuario</td>
                <td class="small text-break"><strong>@l.Metodo</strong> @l.Endpoint</td>
                <td class="text-center"><span class="tag @clase">@l.CodigoEstado</span></td>
                <td class="text-end text-nowrap">@l.DuracionMs ms</td>
                <td class="small"><a asp-action="Logs" asp-route-correlationId="@l.CorrelationId">@l.CorrelationId</a></td>
                <td class="small">
                    @if (l.MensajeError is not null)
                    {
                        <details><summary>@l.MensajeError</summary><pre class="small mb-0" style="white-space:pre-wrap">@l.DetalleError</pre></details>
                    }
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>
